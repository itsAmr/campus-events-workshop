{
  "name": "Campus Events Workshop",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "forwardPorts": [
    3001,
    3002,
    3003,
    5173
  ],
  "portsAttributes": {
    "3001": {
      "label": "API"
    },
    "3002": {
      "label": "MCP"
    },
    "3003": {
      "label": "Chat"
    },
    "5173": {
      "label": "Web"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "humao.rest-client"
      ]
    }
  },
  "remoteUser": "node"
}
